#!/system/bin/sh
# bt-off — disable NetHunter Bluetooth, restore normal Android bluetooth.
echo off > /data/local/tmp/.nexval
for i in $(seq 1 15); do
    [ ! -d /sys/class/bluetooth/hci0 ] && break
    sleep 2
done
sleep 3
svc bluetooth enable 2>/dev/null
sleep 4
if ps -A 2>/dev/null | grep -q android.hardware.bluetooth@1.0; then
    echo "NetHunter BT: disabled. Android bluetooth: back to normal"
else
    echo "NetHunter BT: disabled. Android bluetooth: toggle it once in Settings if needed"
fi
