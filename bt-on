#!/system/bin/sh
# bt-on — enable NetHunter Bluetooth (hci0) on bcm4375b1.
# The privileged work runs in the nexmon-iw valloop daemon; this wrapper
# just triggers it and waits for hci0.
echo on > /data/local/tmp/.nexval
for i in $(seq 1 45); do
    if [ -d /sys/class/bluetooth/hci0 ]; then
        echo "NetHunter BT: hci0 is up (chroot bluez tools ready)"
        exit 0
    fi
    sleep 2
done
echo "NetHunter BT: failed — see /data/adb/modules/nexmon-iw/bt.log"
exit 1
